---
version: "3.8"

services:
  postgres:
    image: {{ pgdocker_swarm_image }}
    environment:
      POSTGRES_DB: {{ pgdocker_swarm_db }}
      POSTGRES_USER: {{ pgdocker_swarm_user }}
      POSTGRES_PASSWORD: "{{ pgdocker_swarm_password }}"
{% for key, value in pgdocker_swarm_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    volumes:
      - type: bind
        source: {{ pgdocker_swarm_data_dir }}
        target: /var/lib/postgresql/data
    networks:
      - pgnet
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U {{ pgdocker_swarm_user }} -d {{ pgdocker_swarm_db }}
      interval: 10s
      timeout: 5s
      retries: 6
    deploy:
      replicas: {{ pgdocker_swarm_replicas }}
      restart_policy:
        condition: any
      placement:
        constraints:
          - node.role == manager

networks:
  pgnet:
    external: true
    name: {{ pgdocker_swarm_network }}
