#!/bin/bash
{{ lookup('file', role_path ~ '/../backup_metrics/files/backup_metrics.sh') }}
set -Eeuo pipefail
###******************************************************************************************###

BACKUPNAME="{{ pgbinbkp_jobname }}"
CURRENT={{ pgbinbkp_data_path | quote }}
PGDATA={{ pgbinbkp_pgdata | quote }}
PGHOST="{{ pgbinbkp_pghost }}"
PGPORT="{{ pgbinbkp_pgport }}"
PGUSER="{{ pgbinbkp_pguser }}"
PG_PASS={{ pgbinbkp_pgpass | quote }}
PG_BASEBACKUP_OPTIONS="{{ pgbinbkp_basebackup_options }}"
SPACE_MARGIN_PERCENT="{{ pgbinbkp_space_margin_percent | default(20) }}"
NODE_EXPORTER_DIR={{ node_exporter_textfile_dir | default('') | quote }}
BACKUP_ROUTE="{{ backup_route | default('dev') }}"
BACKUP_HOST="{{ backup_host | default(inventory_hostname) }}"
###******************************************************************************************###
PG_BASEBACKUP="$(command -v pg_basebackup || true)"
DATE="$(command -v date)"
NOW=$($DATE +%Y%m%d_%H%M%S)

REPLACING=0
SUCCESS=0

bm_init "{{ pgbinbkp_jobname_prefix }}" "postgres" "pgbasebackup_native" \
  "$BACKUP_HOST" "$BACKUP_ROUTE" "$NODE_EXPORTER_DIR"

cleanup() {
  local rc=$?
  trap - EXIT
  if [ "$SUCCESS" -ne 1 ]; then
    bm_phase_fail backup || true
  fi
  if [ "$REPLACING" -eq 1 ] && [ "$SUCCESS" -ne 1 ]; then
    echo "$NOW: removing incomplete backup $CURRENT" >&2
    rm -rf -- "${CURRENT:?}"
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ -z "$CURRENT" ] || [ "$CURRENT" = "/" ]; then
  echo "$NOW: refusing unsafe backup path: '$CURRENT'" >&2
  exit 1
fi

if [ -z "$PG_BASEBACKUP" ]; then
  echo "$NOW: pg_basebackup not found" >&2
  exit 1
fi

if [ ! -d "$PGDATA" ]; then
  echo "$NOW: PGDATA is not a directory: $PGDATA" >&2
  exit 1
fi

# --- free space check before deleting the current copy ---
need_kb=$(du -sk -- "$PGDATA" | awk '{print $1}')
need_kb=$(( need_kb + need_kb * SPACE_MARGIN_PERCENT / 100 ))
avail_kb=$(df -Pk -- "$(dirname -- "$CURRENT")" | awk 'NR==2 {print $4}')
if [ -d "$CURRENT" ]; then
  current_kb=$(du -sk -- "$CURRENT" | awk '{print $1}')
  avail_kb=$(( avail_kb + current_kb ))
fi
if [ "$avail_kb" -lt "$need_kb" ]; then
  echo "$NOW: not enough space: need ${need_kb}K, have ${avail_kb}K" >&2
  exit 1
fi
echo "$NOW: space check ok: need ${need_kb}K, have ${avail_kb}K"

bm_phase_start backup

# --- replace the current local backup ---
umask 077
REPLACING=1
rm -rf -- "${CURRENT:?}"
mkdir -p -- "$CURRENT"

if ! PGPASSWORD="$PG_PASS" "$PG_BASEBACKUP" -D "$CURRENT" -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" $PG_BASEBACKUP_OPTIONS; then
  echo "$NOW: pg_basebackup failed" >&2
  exit 1
fi

chmod -R go-rwx -- "$CURRENT"
chmod 0700 -- "$CURRENT"
ARCHIVE_SIZE=$(du -sh -- "$CURRENT" | awk '{print $1}')
SIZE_BYTES=$(du -sb -- "$CURRENT" | awk '{print $1}')
SUCCESS=1
bm_phase_success backup "$SIZE_BYTES" || true
echo "$NOW: backup created: $CURRENT ($ARCHIVE_SIZE)"


trap - EXIT
exit 0
