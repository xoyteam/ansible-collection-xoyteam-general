#!/bin/bash

{{ lookup('file', role_path ~ '/../backup_metrics/files/backup_metrics.sh') }}

# Авторизационные данные для подключения к хранилищу

# Установка переменных
DATE="$(command -v date)"
NOW=$($DATE +%Y%m%d_%H%M%S)
node_exporter_textfile_dir="{{ node_exporter_textfile_dir | default('/var/lib/node_exporter') }}"
BKPTARGET="{{ duplicitybkp_ssh_backup_target }}"
BKPSTORE="{{ duplicitybkp_ssh_store_dsn }}"
JOBNAME="{{ duplicitybkp_ssh_jobname_prefix }}"
BACKUP_ROUTE="{{ backup_route | default('dev') }}"
BACKUP_HOST="{{ backup_host | default(inventory_hostname) }}"

bm_init "$JOBNAME" "{{ backup_kind | default('files') }}" "duplicitybkp_ssh" \
  "$BACKUP_HOST" "$BACKUP_ROUTE" "$node_exporter_textfile_dir"
bm_phase_start upload

READY_FILE="{{ duplicitybkp_ssh_ready_file | default('') }}"
LOCK_FILE="{{ duplicitybkp_ssh_lock_file | default('') }}"
LOCK_WAIT="{{ duplicitybkp_ssh_lock_wait | default(0) }}"

###******************************************************************************************###
# Готовность данных. Роль-производитель (pgbasebackup_extdkr) держит flock,
# пока пишет копию, и снимает маркер готовности до замены текущей копии.
# Здесь: дождаться освобождения lock (не дольше LOCK_WAIT секунд), затем
# проверить маркер и непустой каталог. При неготовности upload падает, чтобы
# мониторинг увидел сбой (backup_last_attempt_success=0), а не отправил
# недописанные данные.
###******************************************************************************************###
if [ -n "$LOCK_FILE" ]; then
  if ! command -v flock >/dev/null 2>&1; then
    echo "$NOW: ERROR: flock is not available, but duplicitybkp_ssh_lock_file is set ($LOCK_FILE)" >&2
    bm_phase_fail upload
    exit 1
  fi
  mkdir -p -- "$(dirname -- "$LOCK_FILE")"
  exec 9>"$LOCK_FILE" || {
    echo "$NOW: ERROR: cannot open lock file $LOCK_FILE" >&2
    bm_phase_fail upload
    exit 1
  }
  case "$LOCK_WAIT" in
    ''|*[!0-9]*) LOCK_WAIT=0 ;;
  esac
  if [ "$LOCK_WAIT" -gt 0 ]; then
    if ! flock -w "$LOCK_WAIT" 9; then
      echo "$NOW: ERROR: backup is still running (lock $LOCK_FILE, waited ${LOCK_WAIT}s); upload aborted" >&2
      bm_phase_fail upload
      exit 75
    fi
  elif ! flock -n 9; then
    echo "$NOW: ERROR: backup is still running (lock $LOCK_FILE); upload aborted" >&2
    bm_phase_fail upload
    exit 75
  fi
fi

if [ -n "$READY_FILE" ]; then
  if [ ! -f "$READY_FILE" ]; then
    echo "$NOW: ERROR: backup is not ready: marker $READY_FILE is absent (backup failed or not finished)" >&2
    bm_phase_fail upload
    exit 1
  fi
  if [ ! -d "$BKPTARGET" ] || [ -z "$(ls -A -- "$BKPTARGET" 2>/dev/null)" ]; then
    echo "$NOW: ERROR: backup is not ready: $BKPTARGET is missing or empty" >&2
    bm_phase_fail upload
    exit 1
  fi
  echo "$NOW: backup ready: $(sed -n 's/^finished_at_iso=//p' "$READY_FILE" 2>/dev/null || true)"
fi

# Выполнение архивирования
/usr/bin/duplicity \
    --volsize {{ duplicitybkp_volsize }} \
    --no-encryption \
    --allow-source-mismatch \
    --full-if-older-than {{ duplicitybkp_fullevry|d('30D') }} \
    {% if duplicitybkp_ssh_exclude_list is defined %}
    --exclude-filelist "${EXCLUDE_FILE}" \
    {% endif -%}
    {{ _duplicitybkp_extraopts }} \
    ${BKPTARGET} \
    ${BKPSTORE}
rc=$?;
if [[ $rc -ne 0 ]]; then
  echo "$NOW: ERROR: duplicity upload failed (rc=$rc)" >&2
  bm_phase_fail upload
  exit "$rc"
fi
echo "$NOW: backup uploaded successfully"

BACKUP_SIZE=$(du -sb -- "$BKPTARGET" 2>/dev/null | awk '{print $1}' || true)
bm_phase_success upload "${BACKUP_SIZE:-}" || true

/usr/bin/duplicity \
    --no-encryption \
    remove-older-than {{ duplicitybkp_removeolder|d('31D') }} \
    --force \
    {{ _duplicitybkp_extraopts }} \
    ${BKPSTORE}

/usr/bin/duplicity \
    --no-encryption \
    remove-all-but-n-full {{ duplicitybkp_fullcopies|d('1') }} \
    --force \
    {{ _duplicitybkp_extraopts }} \
    ${BKPSTORE}


